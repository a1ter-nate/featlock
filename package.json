{
  "name": "featlock",
  "version": "0.1.0",
  "type": "module",
  "description": "Tight-core, plugin-extensible SQLite feature, test, and invariant registry & agent guard system — combining AST scanners, RepoSpec graphs, Veristack verification signals, and multi-pass AI agent discovery.",
  "license": "MIT",
  "homepage": "https://github.com/a1ter-nate/featlock#readme",
  "bugs": {
    "url": "https://github.com/a1ter-nate/featlock/issues"
  },
  "keywords": [
    "features",
    "invariants",
    "anti-deletion",
    "sqlite",
    "ai-agents",
    "static-analysis",
    "verification",
    "guardrails",
    "bun"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/",
    "dist/",
    "src/",
    "packages/",
    "examples/plugins/demo-toggle/",
    "skill/",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a1ter-nate/featlock.git"
  },
  "bin": {
    "featlock": "bin/featlock.mjs",
    "flk": "bin/featlock.mjs"
  },
  "workspaces": [
    "packages/*",
    "packages/plugins/*"
  ],
  "exports": {
    ".": "./packages/core/src/index.ts",
    "./core": "./packages/core/src/index.ts",
    "./plugin": "./packages/plugin/src/index.ts"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "build": "bun build src/cli.ts --outfile dist/cli.mjs --target bun --external oxc-parser",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check:max-lines": "node scripts/check-max-lines.mjs",
    "perf:check": "bun scripts/check-perf-budget.mjs",
    "lint:oxlint": "bunx oxlint -c .oxlintrc.json --deny-warnings src packages tests examples",
    "lint:no-comments": "bunx vstack no-comments . --fail",
    "lint:state-machines": "bunx vstack state-machines . --fail",
    "check:vstack": "bunx vstack verify . --strict",
    "check:repospec": "bunx repospec check . --allow-fail",
    "check:self-features": "bun src/cli.ts check .",
    "check": "bun run typecheck && bun run lint:oxlint && bun run check:max-lines && bun run build && bun run perf:check && bun run lint:no-comments && bun run lint:state-machines && bunx vstack formal-sync . --fail && bunx vstack laws . --fail && bunx vstack verify . --strict && bun run check:self-features"
  },
  "dependencies": {
    "oxc-parser": "^0.160.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "fast-check": "^4.11.0",
    "oxlint": "^1.95.0",
    "repospec": "^5.0.0",
    "typescript": "^5.8.2",
    "veristack": "^0.1.18"
  }
}
